# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Project rule: free resources only. Every service below has a free tier.

# ---- LLM providers (hybrid free: Groq + Google AI Studio, Ollama fallback) ----
# Free key from console.groq.com > API Keys
GROQ_API_KEY=
# Free key from aistudio.google.com > Get API key
GOOGLE_API_KEY=
# Local Ollama server (offline fallback; no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Tracing: LangSmith (free Developer tier) ----
# Set to "true" to send traces
LANGSMITH_TRACING=false
# From smith.langchain.com > Settings > API Keys
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autoclaim-adjudicator

# ---- Kaggle (Step 1 data download; free account) ----
# New-style token (starts with KGAT_) from kaggle.com > Settings > API > Create New Token
KAGGLE_API_TOKEN=
# Legacy alternative (kaggle.json username + key); leave blank if using KAGGLE_API_TOKEN
KAGGLE_USERNAME=
KAGGLE_KEY=

# Demo photos for the UI (free): https://unsplash.com/developers  (or PEXELS_API_KEY)
UNSPLASH_ACCESS_KEY=
